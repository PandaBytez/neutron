<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.pandabytez.neutron</id>
  <name>Neutron</name>
  <summary>Manage WireGuard connections with NetworkManager</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.pandabytez">
    <name>Neutron</name>
  </developer>
  <description>
    <p>
      Neutron is a lightweight tool for managing WireGuard connections
      through NetworkManager.
    </p>
    <p>Features:</p>
    <ul>
      <li>Connect, disconnect, and switch between WireGuard profiles</li>
      <li>Import WireGuard configuration files as NetworkManager profiles</li>
      <li>Select a random profile once per boot from an eligible pool</li>
      <li>Enable a global NetworkManager-native kill switch for all profiles</li>
      <li>Enable an always-on lockdown firewall that blocks all non-tunnel traffic, even while disconnected</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.pandabytez.neutron.desktop</launchable>
  <url type="homepage">https://github.com/PandaBytez/neutron</url>
  <url type="bugtracker">https://github.com/PandaBytez/neutron/issues</url>
  <url type="vcs-browser">https://github.com/PandaBytez/neutron</url>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/PandaBytez/neutron/main/docs/screenshots/Neutron-Connected.png</image>
      <caption>Manage and switch between WireGuard profiles with real-time telemetry</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/PandaBytez/neutron/main/docs/screenshots/Neutron-Themes.png</image>
