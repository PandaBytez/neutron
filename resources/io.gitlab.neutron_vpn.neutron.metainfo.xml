<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.gitlab.neutron_vpn.neutron</id>
  <name>Neutron VPN</name>
  <summary>Manage VPN connections with NetworkManager</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.gitlab.neutron_vpn">
    <name>Neutron VPN</name>
  </developer>
  <description>
    <p>
      Neutron VPN is a provider-agnostic desktop tool for managing VPN connections
      through NetworkManager. It currently supports WireGuard profiles, with
      additional protocols planned.
    </p>
    <p>Features:</p>
    <ul>
      <li>Connect, disconnect, and switch between WireGuard profiles</li>
      <li>Import WireGuard configuration files as NetworkManager profiles</li>
      <li>Select a random profile once per boot from an eligible pool</li>
      <li>Enable a global NetworkManager-native kill switch for all profiles</li>
      <li>Enable an always-on lockdown firewall that blocks all non-VPN traffic, even while disconnected</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.gitlab.neutron_vpn.neutron.desktop</launchable>
  <url type="homepage">https://github.com/PandaBytez/neutron</url>
  <url type="bugtracker">https://github.com/PandaBytez/neutron/issues</url>
  <url type="vcs-browser">https://github.com/PandaBytez/neutron</url>
  <screenshots>
    <screenshot type="default">
      <image>https://gitlab.com/neutron-vpn/neutron/-/raw/v0.1.0/screenshots/Main-page.png</image>
      <caption>Manage and switch between WireGuard profiles</caption>
    </screenshot>
    <screenshot>
      <image>https://gitlab.com/neutron-vpn/neutron/-/raw/v0.1.0/screenshots/Import-page.png</image>
      <caption>Import a profile from a provider or a file</caption>
    </screenshot>
    <screenshot>
      <image>https://gitlab.com/neutron-vpn/neutron/-/raw/v0.1.0/screenshots/Startup-dropdown.png</image>
      <caption>Choose what connects at startup</caption>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1" />
  <provides>
    <binary>neutron-vpn</binary>
  </provides>
  <releases>
    <release version="0.1.0" date="2026-06-07">
      <description>
        <p>Initial release.</p>
      </description>
    </release>
  </releases>
</component>
