{
  "app-id": "io.gitlab.zento_vpn_manager.zento",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "wireguard-manager",
  "finish-args": [
    "--share=network",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--share=ipc",
    "--device=dri",
    "--talk-name=org.freedesktop.Flatpak",
    "--talk-name=org.freedesktop.NetworkManager",
    "--system-talk-name=org.freedesktop.NetworkManager"
  ],
  "modules": [
    {
      "name": "zento",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
          "CARGO_HOME": "/run/build/zento/cargo",
          "CARGO_NET_OFFLINE": "true"
        }
      },
      "build-commands": [
        "cargo --offline build --release --locked --features gui",
        "install -Dm755 target/release/wireguard-manager /app/bin/wireguard-manager",
        "install -Dm644 flatpak/io.gitlab.zento_vpn_manager.zento.desktop /app/share/applications/io.gitlab.zento_vpn_manager.zento.desktop",
        "install -Dm644 flatpak/io.gitlab.zento_vpn_manager.zento.metainfo.xml /app/share/metainfo/io.gitlab.zento_vpn_manager.zento.metainfo.xml",
        "install -Dm644 flatpak/io.gitlab.zento_vpn_manager.zento.svg /app/share/icons/hicolor/scalable/apps/io.gitlab.zento_vpn_manager.zento.svg"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            "target",
            ".flatpak-builder",
            "build-dir",
            ".git",
            ".idea"
          ]
        },
        "cargo-sources.json"
      ]
    }
  ]
}
